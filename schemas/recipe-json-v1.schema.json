{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recipe Box recipe JSON",
  "description": "Portable, text-only recipes for importing into the currently open publication.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "recipes"],
  "properties": {
    "format": {
      "const": "recipe-box-recipe-json",
      "description": "Format identifier. Keep this value unchanged."
    },
    "schema_version": {
      "const": 1,
      "description": "Recipe JSON format version. Keep this value unchanged."
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "description": "One or more recipes to add to the open publication.",
      "items": { "$ref": "#/$defs/recipe" }
    }
  },
  "$defs": {
    "nutritionValues": {
      "type": "object",
      "additionalProperties": false,
      "description": "Nonnegative nutrient amounts. Omit nutrients without a value.",
      "properties": {
        "calories": { "type": "number", "minimum": 0 },
        "total_fat": { "type": "number", "minimum": 0 },
        "saturated_fat": { "type": "number", "minimum": 0 },
        "trans_fat": { "type": "number", "minimum": 0 },
        "cholesterol": { "type": "number", "minimum": 0 },
        "sodium": { "type": "number", "minimum": 0 },
        "total_carbohydrate": { "type": "number", "minimum": 0 },
        "dietary_fiber": { "type": "number", "minimum": 0 },
        "total_sugars": { "type": "number", "minimum": 0 },
        "added_sugars": { "type": "number", "minimum": 0 },
        "protein": { "type": "number", "minimum": 0 },
        "vitamin_d": { "type": "number", "minimum": 0 },
        "calcium": { "type": "number", "minimum": 0 },
        "iron": { "type": "number", "minimum": 0 },
        "potassium": { "type": "number", "minimum": 0 },
        "vitamin_a": { "type": "number", "minimum": 0 },
        "vitamin_c": { "type": "number", "minimum": 0 },
        "vitamin_e": { "type": "number", "minimum": 0 },
        "vitamin_k": { "type": "number", "minimum": 0 },
        "thiamin": { "type": "number", "minimum": 0 },
        "riboflavin": { "type": "number", "minimum": 0 },
        "niacin": { "type": "number", "minimum": 0 },
        "vitamin_b6": { "type": "number", "minimum": 0 },
        "folate": { "type": "number", "minimum": 0 },
        "vitamin_b12": { "type": "number", "minimum": 0 },
        "biotin": { "type": "number", "minimum": 0 },
        "pantothenic_acid": { "type": "number", "minimum": 0 },
        "choline": { "type": "number", "minimum": 0 },
        "phosphorus": { "type": "number", "minimum": 0 },
        "iodine": { "type": "number", "minimum": 0 },
        "magnesium": { "type": "number", "minimum": 0 },
        "zinc": { "type": "number", "minimum": 0 },
        "selenium": { "type": "number", "minimum": 0 },
        "copper": { "type": "number", "minimum": 0 },
        "manganese": { "type": "number", "minimum": 0 },
        "chromium": { "type": "number", "minimum": 0 },
        "molybdenum": { "type": "number", "minimum": 0 },
        "chloride": { "type": "number", "minimum": 0 }
      }
    },
    "nutritionBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "dimension", "unit"],
      "properties": {
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "dimension": { "enum": ["volume", "weight"] },
        "unit": {
          "type": "string",
          "description": "Volume units: tsp, tbsp, fl_oz, cup, pt, qt, gal, ml, l. Weight units: oz, lb, g, kg."
        }
      }
    },
    "volumeMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount", "unit"],
      "properties": {
        "type": { "const": "volume" },
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "unit": {
          "enum": ["tsp", "tbsp", "fl_oz", "cup", "pt", "qt", "gal", "ml", "l"]
        }
      }
    },
    "weightMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount", "unit"],
      "properties": {
        "type": { "const": "weight" },
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["oz", "lb", "g", "kg"] }
      }
    },
    "countMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount"],
      "properties": {
        "type": { "const": "count" },
        "amount": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "informalMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount", "value"],
      "properties": {
        "type": { "const": "informal" },
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "amount_is_a": {
          "type": "boolean",
          "description": "Set true only for the indefinite article a; amount must be 1."
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "An account-managed Informal unit label."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "amount_is_a": { "const": true } },
            "required": ["amount_is_a"]
          },
          "then": { "properties": { "amount": { "const": 1 } } }
        }
      ]
    },
    "unmeasuredMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "unmeasured" },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "An account-managed Unmeasured phrase."
        }
      }
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "ingredient_set": {
          "type": "string",
          "minLength": 1,
          "description": "A label from ingredient_sets. Defaults to the first set."
        },
        "name": { "type": "string", "minLength": 1 },
        "is_main": { "type": "boolean", "description": "Whether this is the main ingredient." },
        "detail": { "type": "string", "description": "Ingredient-specific detail." },
        "alternate_note": { "type": "string", "description": "Alternate ingredient note." },
        "preparation": { "type": "string", "description": "Preparation text, such as chopped." },
        "measurements": {
          "type": "array",
          "maxItems": 2,
          "description": "At most one each of Volume, Weight, Count, Informal, or Unmeasured; only Volume and Weight may be paired.",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/volumeMeasurement" },
              { "$ref": "#/$defs/weightMeasurement" },
              { "$ref": "#/$defs/countMeasurement" },
              { "$ref": "#/$defs/informalMeasurement" },
              { "$ref": "#/$defs/unmeasuredMeasurement" }
            ]
          }
        },
        "portion_one_ratio": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "description": "Optional first-portion ratio between zero and one."
        },
        "size_value": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "description": "Optional ingredient size for cubed, diced, or sliced preparation."
        },
        "size_unit": {
          "type": ["string", "null"],
          "enum": ["in", "cm", null]
        },
        "nutrition_serving_size": {
          "anyOf": [{ "$ref": "#/$defs/nutritionBasis" }, { "type": "null" }],
          "description": "Optional serving-size basis for ingredient nutrition overrides."
        },
        "nutrition_overrides": {
          "$ref": "#/$defs/nutritionValues",
          "description": "Optional ingredient nutrient values; provide nutrition_serving_size when the ingredient has no catalog nutrition profile."
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Required recipe name." },
        "food_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Account-managed Food Type label."
        },
        "state": {
          "enum": ["want_to_try", "tried", "will_not_try"],
          "description": "Recipe state; omitted values default to want_to_try."
        },
        "verdict": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Account-managed Verdict label; valid only when state is tried."
        },
        "enthusiasm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Account-managed Enthusiasm label; valid only when state is want_to_try."
        },
        "score": {
          "enum": [-5, -3, -1, 0, 1, 2, 3, 4, 5],
          "description": "Optional Rating, allowed only when state is tried."
        },
        "occasion_details": {
          "type": "string",
          "description": "Optional details when the selected Verdict or Enthusiasm is Specific Occasion."
        },
        "reason": {
          "type": "string",
          "description": "Optional reason; valid only when state is will_not_try."
        },
        "serves": {
          "type": "integer",
          "minimum": 1,
          "description": "Positive whole-number serving count."
        },
        "makes_quantity": {
          "type": "integer",
          "minimum": 1,
          "description": "Positive whole-number quantity made; requires makes_thing."
        },
        "makes_thing": {
          "type": "string",
          "minLength": 1,
          "description": "What the recipe makes; requires makes_quantity."
        },
        "time_entries": {
          "type": "array",
          "description": "Ordered duration entries in whole minutes.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "minutes"],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "Account-managed Time Type label."
              },
              "minutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            }
          }
        },
        "nutrition_overrides": {
          "$ref": "#/$defs/nutritionValues",
          "description": "Optional nutrient amounts per serving; requires serves."
        },
        "meal_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": "Account-managed Meal Type labels."
        },
        "cuisines": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": "Account-managed Cuisine labels."
        },
        "equipment": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": "Account-managed Equipment labels."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 160 },
          "description": "Tag names; missing tags are created during import."
        },
        "publication_page": {
          "type": "string",
          "description": "Optional page or location in the publication being imported into."
        },
        "recipe_url": {
          "type": "string",
          "minLength": 1,
          "description": "Optional HTTP(S) recipe URL. It is stored as data and never fetched."
        },
        "ingredient_sets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": "Ordered ingredient section labels; omitted values default to Main."
        },
        "ingredients": {
          "type": "array",
          "items": { "$ref": "#/$defs/ingredient" }
        },
        "prep_ahead": {
          "type": "string",
          "description": "Pre-recipe Prep Markdown."
        },
        "instructions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ordered instruction-step Markdown."
        },
        "notes": {
          "type": "string",
          "description": "Recipe notes Markdown."
        },
        "references": {
          "type": "array",
          "description": "Supplemental external URL or printed-citation references.",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "display_text", "url"],
                "properties": {
                  "type": { "const": "external_url" },
                  "display_text": { "type": "string", "minLength": 1 },
                  "url": { "type": "string", "minLength": 1 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "display_text"],
                "properties": {
                  "type": { "const": "printed_citation" },
                  "display_text": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
