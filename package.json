{
  "name": "recipe-box",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/run-local.mjs",
    "dev:local": "node scripts/run-local.mjs --reset",
    "dev:test": "node scripts/run-local.mjs --test --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src tests scripts next.config.mjs playwright.config.ts vitest.config.mts postcss.config.mjs package.json tsconfig.json",
    "lint:md": "node scripts/lint-markdown.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e && npm run test:a11y",
    "test:unit": "npm run test:bootstrap-admin && vitest run",
    "test:e2e": "playwright test --grep @e2e",
    "test:a11y": "playwright test --grep @a11y",
    "test:migration:magazine": "node scripts/test-magazine-migration.mjs",
    "test:migration:recipe-tin": "node scripts/test-recipe-tin-migration.mjs",
    "test:migration:public-links": "node scripts/test-public-links-migration.mjs",
    "test:migration:ingredient-portions": "node scripts/test-ingredient-portions-migration.mjs",
    "test:bootstrap-admin": "node --test scripts/bootstrap-first-admin.test.mjs",
    "bootstrap:admin": "node scripts/bootstrap-first-admin.mjs",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:stop": "supabase stop"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tiptap/extension-mention": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "archiver": "^8.0.0",
    "heic-convert": "2.1.0",
    "isbn3": "^2.0.12",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-advanced-cropper": "0.20.1",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tus-js-client": "^4.3.1",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "6.1.1",
    "fflate": "^0.8.3",
    "jsdom": "30.1.1",
    "markdownlint": "0.36.1",
    "pdfjs-dist": "^4.10.38",
    "postcss": "8.5.28",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "markdownlint": {
      "markdown-it": "14.3.1"
    }
  }
}
